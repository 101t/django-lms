# Copy to `.env` and adjust. Every setting is optional in development (DEBUG=true).

DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
# Required behind HTTPS, e.g. https://lms.example.edu
CSRF_TRUSTED_ORIGINS=
SITE_NAME=Django LMS
TIME_ZONE=UTC

# Defaults to SQLite in the project folder.
# DATABASE_URL=postgres://lms:password@localhost:5432/lms

# Leave empty to run background tasks inline (no Redis needed).
# REDIS_URL=redis://localhost:6379/0

# Leave EMAIL_HOST empty to print emails to the console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@example.com
